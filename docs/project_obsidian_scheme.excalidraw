      "boundElements": null,
      "updated": 1790025015687,
      "locked": false,
      "text": "Есть глобальный\nсловарь-реестр\nкоманд, сопоставляющий\nназванию\nкоманду (Command).\nЧерез него достается\nнужная команда, и запускается\nс соотв. аргументами",
      "rawText": "Есть глобальный\nсловарь-реестр\nкоманд, сопоставляющий\nназванию\nкоманду (Command).\nЧерез него достается\nнужная команда, и запускается\nс соотв. аргументами",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Есть глобальный\nсловарь-реестр\nкоманд, сопоставляющий\nназванию\nкоманду (Command).\nЧерез него достается\nнужная команда, и запускается\nс соотв. аргументами",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
