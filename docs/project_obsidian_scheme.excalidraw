        {
          "id": "cqys28zn",
          "type": "arrow"
        }
      ],
      "updated": 1790025525242,
      "locked": false,
      "text": "методы:\n+ preprocess() -- назначить во всех вершинах поддерева дескрипторы и\nenvScope'ы\n+ process() -- запустить  программу поддерева:\n    - если это лист, распарсить соответствующую ему строку на список\nаргументов, подставив вместо $ значения из envScope'а\n    - если это внутренняя вершина, запустить process() от левого и правого\nребенка",
      "rawText": "методы:\n+ preprocess() -- назначить во всех вершинах поддерева дескрипторы и\nenvScope'ы\n+ process() -- запустить  программу поддерева:\n    - если это лист, распарсить соответствующую ему строку на список\nаргументов, подставив вместо $ значения из envScope'а\n    - если это внутренняя вершина, запустить process() от левого и правого\nребенка",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "методы:\n+ preprocess() -- назначить во всех вершинах поддерева дескрипторы и\nenvScope'ы\n+ process() -- запустить  программу поддерева:\n    - если это лист, распарсить соответствующую ему строку на список\nаргументов, подставив вместо $ значения из envScope'а\n    - если это внутренняя вершина, запустить process() от левого и правого\nребенка",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
