    {
      "id": "6PkJeGFT",
      "type": "text",
      "x": -239.07174964258917,
      "y": 669.6873672420281,
      "width": 472.9931818259632,
      "height": 160.20016479492185,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 1504679839,
      "version": 1409,
      "versionNonce": 1268697727,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "nyxy4zRY",
          "type": "arrow"
        },
        {
          "id": "7iNxmlW5",
          "type": "arrow"
        }
      ],
      "updated": 1790025572755,
      "locked": false,
      "text": "составная команда-вершина в дереве команд\n(может отвечать за одну команду или блок\nих нескольких). То есть два случая:\n- лист (соответствует одной команде, например echo hello или cat)\n- внутренняя вершина (соответствует блоку команд, например\necho hello | cat). В этом блоке команд есть основной разделитель\n(пайп, точка с запятой или тп), по которому блок бьется на два\nдочерних (в таком случае у мастеркласса есть ссылки на двух\nдетей-мастерклассов)",
      "rawText": "составная команда-вершина в дереве команд\n(может отвечать за одну команду или блок\nих нескольких). То есть два случая:\n- лист (соответствует одной команде, например echo hello или cat)\n- внутренняя вершина (соответствует блоку команд, например\necho hello | cat). В этом блоке команд есть основной разделитель\n(пайп, точка с запятой или тп), по которому блок бьется на два дочерних (в таком случае у мастеркласса есть ссылки на двух детей-мастерклассов)",
      "fontSize": 14.240014648437496,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "составная команда-вершина в дереве команд\n(может отвечать за одну команду или блок\nих нескольких). То есть два случая:\n- лист (соответствует одной команде, например echo hello или cat)\n- внутренняя вершина (соответствует блоку команд, например\necho hello | cat). В этом блоке команд есть основной разделитель\n(пайп, точка с запятой или тп), по которому блок бьется на два дочерних (в таком случае у мастеркласса есть ссылки на двух детей-мастерклассов)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false
    },
